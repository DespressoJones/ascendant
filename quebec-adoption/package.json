{
  "name": "fil-rouge-adoption-quebec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Le fil rouge — an interactive, bilingual guide to adoption and child placement in Québec.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
